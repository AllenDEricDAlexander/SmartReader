{
  "name": "smartreader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "mkdir -p public/cmaps public/standard_fonts && cp node_modules/pdfjs-dist/build/pdf.worker.min.js public/pdf.worker.min.js && cp node_modules/pdfjs-dist/cmaps/* public/cmaps/ && cp node_modules/pdfjs-dist/standard_fonts/* public/standard_fonts/",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "tauri": "tauri dev"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@react-pdf-viewer/core": "3.12.0",
    "@react-pdf-viewer/default-layout": "3.12.0",
    "@react-pdf-viewer/highlight": "3.12.0",
    "@react-pdf-viewer/page-navigation": "3.12.0",
    "@react-pdf-viewer/search": "3.12.0",
    "@react-pdf-viewer/toolbar": "3.12.0",
    "@react-pdf-viewer/zoom": "3.12.0",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "lucide-react": "1.18.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  },
  "patchedDependencies": {
    "@react-pdf-viewer/core@3.12.0": "patches/@react-pdf-viewer%2Fcore@3.12.0.patch"
  }
}
