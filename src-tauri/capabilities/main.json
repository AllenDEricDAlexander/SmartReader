{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main SmartReader desktop window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:read-files",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/**/*.pdf",
        "$HOME/**/*.epub"
      ]
    }
  ]
}
