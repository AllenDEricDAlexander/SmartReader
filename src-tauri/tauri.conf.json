{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SmartReader",
  "version": "0.1.0",
  "identifier": "com.smartreader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SmartReader",
        "width": 1120,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": [],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format"
      },
      {
        "ext": ["epub"],
        "name": "EPUB Book",
        "description": "EPUB digital publication"
      }
    ]
  }
}
